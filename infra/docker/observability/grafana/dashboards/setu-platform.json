      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(setu_readmodel_events_dead_lettered_total[1h])) or vector(0)) + (sum(increase(setu_notification_events_dead_lettered_total[1h])) or vector(0))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
